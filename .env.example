# CheckLis Booking - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Обязательные переменные
# ============================================

# PostgreSQL Database
POSTGRES_DB=checklis
POSTGRES_USER=checklis_user
POSTGRES_PASSWORD=your_secure_password_here

# Backend Security
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_random_secret_key_here

# ============================================
# OPTIONAL - Опциональные переменные
# ============================================

# Redis (default: redis://redis:6379/0)
# REDIS_URL=redis://redis:6379/0

# CORS Origins (default: http://localhost:3000,http://localhost:5173)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Telegram Bot (optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# SMTP Email (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password

# ============================================
# OTHER - Другие настройки
# ============================================

# Node Environment
NODE_ENV=production
