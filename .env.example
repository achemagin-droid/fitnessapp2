# ===========================================
# CheckLis Booking — Переменные окружения
# Скопируйте в .env и заполните своими значениями
# ===========================================

# --- База данных (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=checklis
POSTGRES_USER=checklis_user
POSTGRES_PASSWORD=change_me_to_strong_password

# --- Backend ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_secret_key
CORS_ORIGINS=https://your-domain.com,http://localhost:5173
ADMIN_PASSWORD=change_me_admin_password

# --- Telegram Bot (опционально) ---
# Получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhook/telegram

# --- Email / SMTP (опционально) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=
SMTP_FROM="LIFE Studio <noreply@your-domain.com>"

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- npm (опционально, только для сборки frontend) ---
# Не указывайте https://yandex.ru — это не npm registry.
# Пример возможного endpoint зеркала: https://npm.yandex-team.ru
NPM_REGISTRY=https://registry.npmjs.org
# Для HTTP/mixed-прокси Hiddify: http://host.docker.internal:PORT
NPM_PROXY=

# --- Приложение ---
APP_ENV=production
LOG_LEVEL=info
