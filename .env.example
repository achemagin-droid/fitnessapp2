# CheckLis Booking - Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_DB=checklis
POSTGRES_USER=checklis_user
POSTGRES_PASSWORD=change_this_password

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
DATABASE_URL=postgresql+asyncpg://checklis_user:change_this_password@postgres:5432/checklis
SECRET_KEY=change_this_secret_key_to_something_random_and_long

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# SMTP Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Node Environment
NODE_ENV=production
